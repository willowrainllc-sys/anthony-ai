{
  "cleanUrls": true,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/obsidian_city_dashboard.html"
    },
    {
      "source": "/marketplace",
      "destination": "/obsidian_city_landing.html"
    },
    {
      "source": "/domains",
      "destination": "/obsidian_domains.html"
    },
    {
      "source": "/search",
      "destination": "/obsidian_domain_results.html"
    },
    {
      "source": "/checkout",
      "destination": "/obsidian_unified_checkout.html"
    },
    {
      "source": "/vps",
      "destination": "/obsidian_vps_hosting.html"
    },
    {
      "source": "/wordpress",
      "destination": "/obsidian_wordpress_support.html"
    },
    {
      "source": "/openclaw",
      "destination": "/obsidian_openclaw_hosting.html"
    },
    {
      "source": "/airo",
      "destination": "/obsidian_airo_builder.html"
    },
    {
      "source": "/nodejs",
      "destination": "/obsidian_nodejs_hosting.html"
    },
    {
      "source": "/signin",
      "destination": "/obsidian_signin.html"
    },
    {
      "source": "/developer",
      "destination": "/developer.html"
    },
    {
      "source": "/compliance",
      "destination": "/compliance.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/about",
      "destination": "/obsidian_city_dashboard.html"
    },
    {
      "source": "/help",
      "destination": "/obsidian_help_center.html"
    }
  ]
}
