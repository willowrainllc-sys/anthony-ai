{
  "cleanUrls": true,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/dashboard", "destination": "/obsidian_city_dashboard.html" },
    { "source": "/marketplace", "destination": "/obsidian_city_marketplace.html" },
    { "source": "/domains", "destination": "/obsidian_domains.html" },
    { "source": "/search", "destination": "/obsidian_domain_results.html" },
    { "source": "/checkout", "destination": "/obsidian_unified_checkout.html" },
    { "source": "/vps", "destination": "/obsidian_vps_hosting.html" },
    { "source": "/wordpress", "destination": "/obsidian_wordpress_support.html" },
    { "source": "/airo", "destination": "/obsidian_ai_builder.html" },
    { "source": "/builder", "destination": "/obsidian_ai_builder.html" },
    { "source": "/signin", "destination": "/obsidian_signin.html" },
    { "source": "/register", "destination": "/obsidian_register.html" },
    { "source": "/help", "destination": "/obsidian_help_center.html" },
    { "source": "/profile", "destination": "/obsidian_user_profile.html" },
    { "source": "/whitelabel", "destination": "/obsidian_white_label_licensing.html" },
    { "source": "/chat", "destination": "/ares_oracle_chat_monitor.html" },
    { "source": "/google(.*)\\.html", "destination": "/google$1.html" },
    { "source": "/(.*)\\.html", "destination": "/$1.html" }
  ]
}
